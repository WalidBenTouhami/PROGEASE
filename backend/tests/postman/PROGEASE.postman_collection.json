    {
      "name": "2. Tests des Projets",
      "item": [
        {
          "name": "2.1 Créer un projet",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projets",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User",
                "value": "{{currentUser}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nom\": \"Projet Test {{timestamp}}\",\n    \"description\": \"Description du projet de test\",\n    \"dateDebut\": \"2025-01-01\",\n    \"dateFin\": \"2025-12-31\",\n    \"statut\": \"EN_COURS\",\n    \"responsable\": \"{{currentUser}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Projet is created with correct data\", function () {",
                  "    var responseData = pm.response.json();",
                  "    pm.expect(responseData).to.have.property('_id');",
                  "    pm.expect(responseData.nom).to.include('Projet Test');",
                  "    pm.expect(responseData.responsable).to.eql(pm.globals.get('currentUser'));",
                  "    pm.globals.set(\"projetId\", responseData._id);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.globals.set('timestamp', Date.now());"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Lister les projets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projets",
            "header": [
              {
                "key": "X-User",
                "value": "{{currentUser}}"
              }
            ]
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct structure\", function () {",
                  "    var responseData = pm.response.json();",
                  "    pm.expect(responseData).to.be.an('array');",
                  "    if (responseData.length > 0) {",
                  "        pm.expect(responseData[0]).to.have.property('_id');",
                  "        pm.expect(responseData[0]).to.have.property('nom');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
