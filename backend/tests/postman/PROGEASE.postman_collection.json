      "name": "3. Tests des Livrables",
      "item": [
        {
          "name": "3.1 Créer un livrable",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/livrables",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User",
                "value": "{{currentUser}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"titre\": \"Livrable Test {{timestamp}}\",\n    \"description\": \"Description du livrable de test\",\n    \"type\": \"DOCUMENT\",\n    \"dateEcheance\": \"2025-06-30\",\n    \"statut\": \"EN_COURS\",\n    \"projetId\": \"{{temporaryProjetId}}\",\n    \"responsable\": \"{{currentUser}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.globals.get('temporaryProjetId')) {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.get('baseUrl') + '/api/projets',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'X-User': pm.globals.get('currentUser')",
                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                \"nom\": \"Projet Temporaire \" + Date.now(),",
                  "                \"description\": \"Projet créé pour les tests de livrables\",",
                  "                \"dateDebut\": \"2025-01-01\",",
                  "                \"dateFin\": \"2025-12-31\",",
                  "                \"statut\": \"EN_COURS\",",
                  "                \"responsable\": pm.globals.get('currentUser')",
                  "            })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 201) {",
                  "            pm.globals.set('temporaryProjetId', res.json()._id);",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Livrable is created with correct data\", function () {",
                  "    var responseData = pm.response.json();",
                  "    pm.expect(responseData).to.have.property('_id');",
                  "    pm.expect(responseData.titre).to.include('Livrable Test');",
                  "    pm.expect(responseData.projetId).to.eql(pm.globals.get('temporaryProjetId'));",
                  "    pm.globals.set(\"livrableId\", responseData._id);",
                  "});"
                ]
              }
            }
          ]
        },
