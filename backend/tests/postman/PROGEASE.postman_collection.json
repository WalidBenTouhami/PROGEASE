            "body": {
              "mode": "raw",
              "raw": "{\n    \"text\": \"Ceci est un texte pour analyse. Il contient des informations sur un projet de développement web avec les technologies suivantes: Node.js, Express, MongoDB.\",\n    \"type\": \"texte\",\n    \"options\": {\n        \"language\": \"fr\",\n        \"detailed\": true\n    }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has analysis result\", function () {",
                  "    var responseData = pm.response.json();",
                  "    pm.expect(responseData).to.have.property('analysis');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Tester les limites de l'API IA",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/ai/analyze",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User",
                "value": "{{currentUser}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"text\": \"Texte court\",\n    \"type\": \"texte\",\n    \"options\": {\n        \"language\": \"fr\",\n        \"detailed\": true\n    }\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API handles short text\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "    var responseData = pm.response.json();",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(responseData).to.have.property('analysis');",
                  "    } else if (pm.response.code === 400) {",
                  "        pm.expect(responseData).to.have.property('erreur');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
