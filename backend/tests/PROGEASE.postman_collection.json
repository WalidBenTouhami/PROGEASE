                                "});",
                                "",
                                "// Nettoyer les variables",
                                "pm.environment.unset(\"projetId\");",
                                "pm.environment.unset(\"livrableId\");"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "DELETE",
                    "header": [],
                    "url": "{{baseUrl}}/api/projets/{{projetId}}"
                }
            }
        ]
    },
