    "item": [
        {
            "name": "Santé API",
            "item": [
                {
                    "name": "GET /health",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Status field est 'ok'\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.status).to.eql('ok');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/health"
                    }
                },
                {
                    "name": "GET /api",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Contient les endpoints attendus\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.endpoints).to.include('/api/projets');",
                                    "    pm.expect(jsonData.endpoints).to.include('/api/livrables');",
                                    "    pm.expect(jsonData.endpoints).to.include('/graphql');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api"
                    }
                }
            ]
        },
        {
            "name": "Gestion des projets",
            "item": [
                {
                    "name": "Créer un projet",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 201 Created\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Projet créé avec ID\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData._id).to.exist;",
                                    "    pm.expect(jsonData.titre).to.eql(pm.variables.get(\"projetTitre\"));",
                                    "",
                                    "    // Stocker l'ID pour les tests suivants",
                                    "    pm.environment.set(\"projetId\", jsonData._id);",
                                    "});"
                                ]
                            }
                        },
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// Générer des données de test dynamiques",
                                    "pm.variables.set(\"projetTitre\", \"Projet Test \" + new Date().toISOString());",
                                    "pm.variables.set(\"projetDescription\", \"Description générée pour les tests automatisés\");"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"titre\": \"{{projetTitre}}\",\n    \"description\": \"{{projetDescription}}\",\n    \"dateDebut\": \"{{$isoTimestamp}}\",\n    \"dateFin\": \"{{$isoTimestampMs + 2592000000}}\",\n    \"competences\": [\"JavaScript\", \"Node.js\", \"MongoDB\"],\n    \"statut\": \"Brouillon\"\n}"
                        },
                        "url": "{{baseUrl}}/api/projets"
                    }
                },
                {
                    "name": "Récupérer tous les projets",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Liste de projets reçue\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.projets).to.be.an('array');",
                                    "    pm.expect(jsonData.total).to.be.at.least(1);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/projets?page=1&limit=10",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "projets"],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Récupérer un projet par ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Détails du projet corrects\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData._id).to.eql(pm.environment.get(\"projetId\"));",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": "{{baseUrl}}/api/projets/{{projetId}}"
                    }
                },
                {
                    "name": "Mettre à jour un projet",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Projet mis à jour correctement\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.description).to.eql(pm.variables.get(\"nouvelleDescription\"));",
                                    "});"
                                ]
                            }
                        },
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.variables.set(\"nouvelleDescription\", \"Description mise à jour \" + new Date().toISOString());"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"titre\": \"{{projetTitre}} (mis à jour)\",\n    \"description\": \"{{nouvelleDescription}}\",\n    \"statut\": \"En cours\"\n}"
                        },
                        "url": "{{baseUrl}}/api/projets/{{projetId}}"
                    }
                },
                {
                    "name": "Analyse des risques",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Contient une analyse des risques\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.projetId).to.eql(pm.environment.get(\"projetId\"));",
                                    "    pm.expect(jsonData.risques).to.be.an('array');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"projetId\": \"{{projetId}}\",\n    \"currentUser\": \"{{$randomFullName}}\"\n}"
                        },
                        "url": "{{baseUrl}}/api/projets/analyse-risques"
                    }
                }
            ]
        },
        {
            "name": "Gestion des livrables",
            "item": [
