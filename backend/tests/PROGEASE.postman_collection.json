                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/livrables",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "livrables"]
                        }
                    }
                },
                {
                    "name": "3.3 Obtenir un livrable par ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Livrable data is correct\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"livrableId\"));",
                                    "    pm.expect(jsonData.title).to.eql(pm.variables.get(\"livrableTitle\"));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
