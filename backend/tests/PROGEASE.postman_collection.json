                                    "pm.test(\"Liste de livrables reçue\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.livrables).to.be.an('array');",
                                    "    pm.expect(jsonData.livrables.length).to.be.at.least(1);",
                                    "});"
