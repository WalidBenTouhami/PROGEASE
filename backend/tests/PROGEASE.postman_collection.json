                            ]
                        }
                    }
                ],
                "request": {
                    "method": "PUT",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": {
                        "mode": "raw",
                        "raw": "{\n    \"titre\": \"{{livrableTitre}} (mis à jour)\",\n    \"nom\": \"{{livrableTitre}} (mis à jour)\",\n    \"description\": \"{{nouvelleLivrableDescription}}\",\n    \"projetId\": \"{{projetId}}\",\n    \"statut\": \"termine\"\n}"
                    },
                    "url": "{{baseUrl}}/api/livrables/{{livrableId}}"
                }
            },
            {
                "name": "3.5 Supprimer un livrable",
                "event": [
                    {
                        "listen": "test",
