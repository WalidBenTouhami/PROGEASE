                                    "pm.test(\"Détails du livrable corrects\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData._id).to.eql(pm.environment.get(\"livrableId\"));",
                                    "});"
                                ]
