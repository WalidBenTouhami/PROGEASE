            {
                "name": "5.3 Mutation Créer Projet",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 200\", function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"GraphQL mutation created project\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData.data).to.exist;",
                                "    // Stocker l'ID GraphQL pour le test de suppression",
                                "    if (jsonData.data && jsonData.data.createProjet && jsonData.data.createProjet._id) {",
                                "        pm.environment.set(\"graphqlProjetId\", jsonData.data.createProjet._id);",
                                "    }",
                                "});"
                            ]
                        }
                    },
                    {
                        "listen": "prerequest",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "const graphqlProjTitle = \"Projet GraphQL \" + Date.now();"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "POST",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
