                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"Livrable is deleted\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData.message || jsonData.deleted || jsonData.result).to.exist;",
                                "});"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "DELETE",
                    "header": [],
