                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Livrable is updated correctly\", function () {",
                                    "    const jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.title).to.eql(pm.variables.get(\"updatedLivrableTitle\"));",
                                    "    pm.expect(jsonData.description).to.eql(pm.variables.get(\"updatedLivrableDescription\"));",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
