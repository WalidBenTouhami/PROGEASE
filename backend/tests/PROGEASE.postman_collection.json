    {
        "name": "2. Tests des Projets",
        "item": [
            {
                "name": "2.1 Créer un projet",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 201\", function () {",
                                "    pm.response.to.have.status(201);",
                                "});",
                                "",
                                "pm.test(\"Projet is created with correct data\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData._id).to.exist;",
                                "    pm.expect(jsonData.titre || jsonData.nom).to.eql(pm.variables.get(\"projetTitre\"));",
                                "",
                                "    // Stocker l'ID pour les tests suivants",
                                "    pm.environment.set(\"projetId\", jsonData._id);",
                                "});"
                            ]
                        }
                    },
                    {
                        "listen": "prerequest",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "// Générer des données de test dynamiques",
                                "const timestamp = Date.now();",
                                "pm.variables.set(\"projetTitre\", \"Projet Test \" + timestamp);",
                                "pm.variables.set(\"projetDescription\", \"Description générée pour les tests automatisés\");",
                                "pm.environment.set(\"timestamp\", timestamp);"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "POST",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": {
                        "mode": "raw",
                        "raw": "{\n    \"titre\": \"{{projetTitre}}\",\n    \"nom\": \"{{projetTitre}}\",\n    \"description\": \"{{projetDescription}}\",\n    \"dateDebut\": \"{{$isoTimestamp}}\",\n    \"dateFin\": \"{{$isoTimestampMs + 2592000000}}\",\n    \"competences\": [\"JavaScript\", \"Node.js\", \"MongoDB\"],\n    \"statut\": \"brouillon\"\n}"
                    },
                    "url": "{{baseUrl}}/api/projets"
                }
            },
            {
                "name": "2.2 Lister les projets",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 200\", function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"Response has correct structure\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    if (Array.isArray(jsonData)) {",
                                "        pm.expect(jsonData).to.be.an('array');",
                                "        if (jsonData.length > 0) {",
                                "            pm.expect(jsonData[0].titre || jsonData[0].nom).to.exist;",
                                "        }",
                                "    } else if (jsonData.projets) {",
                                "        pm.expect(jsonData.projets).to.be.an('array');",
                                "        pm.expect(jsonData.total).to.be.at.least(1);",
                                "    }",
                                "});"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "GET",
                    "header": [],
                    "url": {
                        "raw": "{{baseUrl}}/api/projets",
                        "host": ["{{baseUrl}}"],
                        "path": ["api", "projets"]
                    }
                }
            },
            {
                "name": "2.3 Obtenir un projet par ID",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 200\", function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"Project data is correct\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData._id).to.exist;",
                                "    if (pm.environment.get(\"projetId\")) {",
                                "        pm.expect(jsonData._id).to.eql(pm.environment.get(\"projetId\"));",
                                "    }",
                                "});"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "GET",
                    "header": [],
                    "url": "{{baseUrl}}/api/projets/{{projetId}}"
                }
            },
            {
                "name": "2.4 Mettre à jour un projet",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 200\", function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"Project is updated correctly\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData.description).to.exist;",
                                "    pm.expect(jsonData.description).to.eql(pm.variables.get(\"nouvelleDescription\"));",
                                "});"
                            ]
                        }
                    },
                    {
                        "listen": "prerequest",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.variables.set(\"nouvelleDescription\", \"Description mise à jour \" + pm.environment.get(\"timestamp\"));"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "PUT",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": {
                        "mode": "raw",
                        "raw": "{\n    \"titre\": \"{{projetTitre}} (mis à jour)\",\n    \"nom\": \"{{projetTitre}} (mis à jour)\",\n    \"description\": \"{{nouvelleDescription}}\",\n    \"statut\": \"en_cours\"\n}"
                    },
                    "url": "{{baseUrl}}/api/projets/{{projetId}}"
                }
            },
            {
                "name": "2.5 Supprimer un projet",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 200\", function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test(\"Project is deleted\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData.message || jsonData.result).to.exist;",
                                "});"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "DELETE",
                    "header": [],
                    "url": "{{baseUrl}}/api/projets/{{projetId}}"
                }
            }
        ]
    },
    {
        "name": "3. Tests des Livrables",
        "item": [
            {
                "name": "3.1 Créer un livrable",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test(\"Status code is 201\", function () {",
                                "    pm.response.to.have.status(201);",
                                "});",
                                "",
                                "pm.test(\"Livrable is created with correct data\", function () {",
                                "    var jsonData = pm.response.json();",
                                "    pm.expect(jsonData._id).to.exist;",
                                "    pm.expect(jsonData.titre || jsonData.intitule || jsonData.nom).to.eql(pm.variables.get(\"livrableTitre\"));",
                                "",
                                "    // Stocker l'ID pour les tests suivants",
                                "    pm.environment.set(\"livrableId\", jsonData._id);",
                                "});"
                            ]
                        }
                    },
                    {
                        "listen": "prerequest",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "// Créer un projet d'abord si nécessaire",
                                "if (!pm.environment.get(\"projetId\")) {",
                                "    const timestamp = Date.now();",
                                "    pm.variables.set(\"projetTitre\", \"Projet Test \" + timestamp);",
                                "    pm.environment.set(\"timestamp\", timestamp);",
                                "    ",
                                "    pm.sendRequest({",
                                "        url: pm.variables.get(\"baseUrl\") + \"/api/projets\",",
                                "        method: 'POST',",
                                "        header: {",
                                "            'Content-Type': 'application/json'",
                                "        },",
                                "        body: {",
                                "            mode: 'raw',",
                                "            raw: JSON.stringify({",
                                "                titre: pm.variables.get(\"projetTitre\"),",
                                "                nom: pm.variables.get(\"projetTitre\"),",
                                "                description: \"Projet temporaire pour tests de livrables\",",
                                "                statut: \"brouillon\"",
                                "            })",
                                "        }",
                                "    }, function (err, res) {",
                                "        if (!err && res.code === 201) {",
                                "            const jsonData = res.json();",
                                "            if (jsonData._id) {",
                                "                pm.environment.set(\"projetId\", jsonData._id);",
                                "            }",
                                "        }",
                                "    });",
                                "}",
                                "",
                                "// Générer des données pour le livrable",
                                "pm.variables.set(\"livrableTitre\", \"Livrable Test \" + pm.environment.get(\"timestamp\"));",
                                "pm.variables.set(\"livrableDescription\", \"Description du livrable de test\");"
                            ]
                        }
                    }
                ],
                "request": {
                    "method": "POST",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": {
                        "mode": "raw",
                        "raw": "{\n    \"titre\": \"{{livrableTitre}}\",\n    \"nom\": \"{{livrableTitre}}\",\n    \"description\": \"{{livrableDescription}}\",\n    \"projetId\": \"{{projetId}}\",\n    \"dateEcheance\": \"{{$isoTimestamp}}\",\n    \"statut\": \"a_faire\"\n}"
                    },
                    "url": "{{baseUrl}}/api/livrables"
                }
            },
            {
                "name": "3.2 Lister les livrables",
                "event": [
                    {
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
