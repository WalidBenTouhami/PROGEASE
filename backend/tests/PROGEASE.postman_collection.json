                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"titre\": \"{{livrableTitre}} (mis à jour)\",\n    \"description\": \"{{nouvelleLivrableDescription}}\",\n    \"projetId\": \"{{projetId}}\",\n    \"statut\": \"termine\"\n}"
                        },
                        "url": "{{baseUrl}}/api/livrables/{{livrableId}}"
