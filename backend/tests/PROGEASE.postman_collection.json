        {
            "name": "Nettoyage",
            "item": [
                {
                    "name": "Supprimer le livrable de test",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Livrable supprimé\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.deleted || jsonData.message).to.exist;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "{{baseUrl}}/api/livrables/{{livrableId}}"
                    }
                },
                {
                    "name": "Supprimer le projet de test",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Statut 200 OK\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Projet supprimé\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.message).to.include('supprimé');",
