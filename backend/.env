# Server Configuration
PORT=4000
NODE_ENV=development
SERVER_TIMEOUT=30000
ENABLE_COMPRESSION=true
TRUST_PROXY=false
API_VERSION=v1
COMPRESSION_LEVEL=6
GRAPHQL_PATH=/graphql

# MongoDB Configuration
