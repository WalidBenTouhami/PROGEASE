# 🌐 Configuration MongoDB
# Remplacez `<username>`, `<password>` et `<dbname>` par vos informations.
MONGODB_URI=mongodb+srv://Walid:Progease@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# 🔐 Sécurité JWT
# Clé secrète pour signer les tokens JWT. Gardez-la confidentielle.
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# 🛠️ Configuration Redis
# URL sécurisée pour la connexion à Redis.
REDIS_TLS_URL=rediss://Walid.BENTOUHAMI@ESPRIT.TN:Souvient@1@<redis-host>:6380

# 🔗 GitHub OAuth
# Identifiants pour l'authentification OAuth avec GitHub.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Définir logtail-token
LOGTAIL_TOKEN=your-logtail-token