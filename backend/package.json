{
  "name": "progease-backend",
  "version": "2.0.0",
  "description": "Backend de l'application PROGEASE",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step required for backend'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:newman": "node newman-tests.js",
    "start:mongodb": "node scripts/start-mongodb.js",
    "start:all": "concurrently \"npm run start:mongodb\" \"npm run start\"",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "api",
    "graphql",
    "express",
    "mongoose",
    "projet-management"
  ],
  "author": "WalidBenTouhami",
  "license": "MIT",
  "dependencies": {
    "@apollo/federation": "^0.38.1",
    "@apollo/gateway": "^2.7.1",
    "@apollo/server": "^4.12.1",
    "@apollo/subgraph": "^2.7.1",
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.3",
    "@graphql-tools/schema": "^10.0.3",
    "apollo-server-express": "^3.12.1",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "graphql": "^16.8.1",
    "graphql-http": "^1.22.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mongoose": "^8.15.2",
    "morgan": "^1.10.0",
    "negotiator": "^0.6.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.11",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "newman": "^6.2.0",
    "newman-reporter-htmlextra": "^1.22.11",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
