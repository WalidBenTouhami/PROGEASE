# Server Configuration
PORT=4000
NODE_ENV=development
SERVER_TIMEOUT=30000
ENABLE_COMPRESSION=true
TRUST_PROXY=false

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/progease
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECT_TIMEOUT=10000
DB_SOCKET_TIMEOUT=45000
DB_SERVER_SELECTION_TIMEOUT=5000
DB_HEARTBEAT_FREQUENCY=10000
DB_SSL=false
DB_SSL_VALIDATE=false
DB_AUTH_SOURCE=admin
DB_AUTH_MECHANISM=SCRAM-SHA-256

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=progease-api
JWT_AUDIENCE=progease-client
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
PASSWORD_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=8

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
EMAIL_FROM=noreply@progease.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
ENABLE_FILE_COMPRESSION=true
COMPRESSION_QUALITY=80

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
ENABLE_LOG_ROTATION=true
MAX_LOG_SIZE=20m
MAX_LOG_FILES=5

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later

# Cache Configuration
ENABLE_CACHE=true
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=progease:
CACHE_TTL=3600

# Security Configuration
BCRYPT_SALT_ROUNDS=10 