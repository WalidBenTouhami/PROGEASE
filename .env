# Server Configuration
PORT=4000
NODE_ENV=development
SERVER_TIMEOUT=30000
ENABLE_COMPRESSION=true
TRUST_PROXY=false
API_VERSION=v1
COMPRESSION_LEVEL=6
GRAPHQL_PATH=/graphql

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/progease
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECT_TIMEOUT=10000
DB_SOCKET_TIMEOUT=45000
DB_SERVER_SELECTION_TIMEOUT=5000
DB_HEARTBEAT_FREQUENCY=10000

# Authentication Configuration
JWT_SECRET=progease-super-secret-key-2024
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=progease-api
JWT_AUDIENCE=progease-client
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
PASSWORD_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=8

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=false
EMAIL_FROM=noreply@progease.com

# CORS Configuration (important pour résoudre votre erreur)
CORS_ORIGIN=http://localhost:4200
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=logs

# API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here